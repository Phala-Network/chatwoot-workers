{
  "name": "chatwoot-workers",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces",
    "test": "node --test scripts/docs.test.ts && npm test --workspaces",
    "build": "npm run build --workspaces",
    "check:package": "bash scripts/check-package.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vitest-plugin": "1.4.2",
    "@types/node": "^24.19.1",
    "cf": "1.0.0-beta.20",
    "esbuild": "0.28.2",
    "jsonc-parser": "^3.3.1",
    "openapi-fetch": "^0.17.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
